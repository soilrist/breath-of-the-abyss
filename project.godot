; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="심연의 숨결"
run/main_scene="res://scenes/title.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0.02, 0.027, 0.07, 1)
boot_splash/image="res://assets/ui/boot_splash.png"
config/icon="res://assets/icons/app_icon.png"

[autoload]

GameState="*res://scripts/game_state.gd"
Audio="*res://scripts/audio.gd"
Hit="*res://scripts/hit_feedback.gd"
Story="*res://scripts/story.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=240
window/size/window_width_override=960
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[gui]

theme/custom_font="res://assets/fonts/NotoSansKR-Game.ttf"

