## 그 보스의 격파 대사. 대면에서 고른 답이 있으면 그쪽을 쓴다.
static func boss_fall(key: String, chosen: Array) -> Array:
	for c in chosen:
		if BOSS_FALL_BY_CHOICE.has(c) and str(c).begins_with(key):
			return BOSS_FALL_BY_CHOICE[c]
	return BOSS_FALL.get(key, [])


## 사람 이름. 없으면 키를 그대로 준다.
static func name_of(key: String) -> String:
	return str(NAMES.get(key, key))


## 초상화 경로. 없는 사람이면 빈 문자열.
static func face_of(key: String) -> String:
	if key == "":
		return ""
	return "res://assets/faces/%s.png" % key


## 진행도에 맞는 잡담 한 줄.
static func chatter(who: String, stage: int) -> String:
	var lines: Array = CHATTER.get(who, [])
	var picked := ""
	for entry in lines:
		if stage >= int(entry[0]):
			picked = str(entry[1])
	return picked
